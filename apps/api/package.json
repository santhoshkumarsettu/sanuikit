{
  "name": "@vstudio/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=1 --minWorkers=1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.864.0",
    "@aws-sdk/s3-request-presigner": "^3.864.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/jwt": "^9.1.0",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/websocket": "^11.1.0",
    "@vstudio/auth": "workspace:*",
    "@vstudio/config": "workspace:*",
    "@vstudio/database": "workspace:*",
    "@vstudio/types": "workspace:*",
    "@vstudio/utils": "workspace:*",
    "@vstudio/validation": "workspace:*",
    "@opentelemetry/auto-instrumentations-node": "^0.62.0",
    "@opentelemetry/sdk-node": "^0.203.0",
    "bullmq": "^5.58.5",
    "argon2": "^0.43.0",
    "csv-parse": "^6.1.0",
    "file-type": "^21.0.0",
    "fastify": "^5.5.0",
    "ioredis": "^5.7.0",
    "pino": "^9.9.0",
    "sharp": "^0.34.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.40.0",
    "vitest": "^3.2.0"
  }
}

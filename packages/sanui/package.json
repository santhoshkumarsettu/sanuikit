{
  "name": "sanui",
  "version": "0.1.0",
  "description": "A thoughtfully designed React component library.",
  "license": "MIT",
  "type": "module",
  "sideEffects": ["./dist/styles.css"],
  "files": ["dist"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.7",
    "typescript": "~5.8.3",
    "vite": "^7.0.0"
  }
}

generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationRole {
  OWNER
  ADMIN
  EDITOR
  SALES
  VIEWER
}
enum ProjectType {
  PLOT_LAYOUT
  APARTMENT
  VILLA
  COMMERCIAL
  OFFICE
  PARKING
  WAREHOUSE
  FLOOR_PLAN
  CUSTOM
}
enum ProjectStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}
enum LayoutType {
  SITE_PLAN
  FLOOR_PLAN
  PARKING
  CUSTOM
}
enum UnitType {
  PLOT
  APARTMENT
  VILLA
  OFFICE
  SHOP
  PARKING
  ROOM
  WAREHOUSE
  CUSTOM
}
enum UnitStatus {
  AVAILABLE
  RESERVED
  BOOKED
  SOLD
  BLOCKED
  OFF_MARKET
}
enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
  COMPLETED
}

model Organization {
  id          String               @id @default(uuid()) @db.Uuid
  name        String               @db.VarChar(160)
  slug        String               @unique @db.VarChar(100)
  status      String               @default("ACTIVE") @db.VarChar(24)
  settings    Json                 @default("{}")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")
  members     OrganizationMember[]
  projects    Project[]
  apiKeys     ApiKey[]
  invitations Invitation[]
  auditLogs   AuditLog[]
  uploadIntents LayoutUploadIntent[]
  @@map("organizations")
}

model User {
  id            String               @id @default(uuid()) @db.Uuid
  email         String               @unique @db.VarChar(320)
  passwordHash  String               @map("password_hash") @db.VarChar(255)
  name          String               @db.VarChar(160)
  avatarUrl     String?              @map("avatar_url") @db.VarChar(2048)
  emailVerified DateTime?            @map("email_verified")
  disabledAt    DateTime?            @map("disabled_at")
  lastLoginAt   DateTime?            @map("last_login_at")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")
  memberships   OrganizationMember[]
  sessions      Session[]
  invitations   Invitation[]         @relation("InvitedBy")
  auditLogs     AuditLog[]
  bookings      Booking[]            @relation("BookingCreatedBy")
  @@map("users")
}

model OrganizationMember {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           OrganizationRole @default(VIEWER)
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([organizationId, userId])
  @@index([userId, active])
  @@map("organization_members")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
  @@map("sessions")
}

model Invitation {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  invitedById    String           @map("invited_by_id") @db.Uuid
  email          String           @db.VarChar(320)
  role           OrganizationRole
  tokenHash      String           @unique @map("token_hash") @db.VarChar(128)
  expiresAt      DateTime         @map("expires_at")
  acceptedAt     DateTime?        @map("accepted_at")
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy      User             @relation("InvitedBy", fields: [invitedById], references: [id])
  @@unique([organizationId, email])
  @@map("invitations")
}

model Project {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String       @db.VarChar(120)
  slug           String       @db.VarChar(80)
  description    String?      @db.VarChar(5000)
  projectType    ProjectType  @map("project_type")
  location       String?      @db.VarChar(240)
  status         ProjectStatus @default(DRAFT)
  publicEnabled  Boolean      @default(false) @map("public_enabled")
  publicConfig   Json         @default("{}") @map("public_config")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  layouts        Layout[]
  units          Unit[]
  uploadIntents  LayoutUploadIntent[]
  bookings       Booking[]
  @@unique([organizationId, slug])
  @@index([organizationId, status, updatedAt])
  @@map("projects")
}

model Layout {
  id                 String     @id @default(uuid()) @db.Uuid
  organizationId     String     @map("organization_id") @db.Uuid
  projectId          String     @map("project_id") @db.Uuid
  name               String     @db.VarChar(120)
  type               LayoutType @default(SITE_PLAN)
  originalAssetKey   String     @map("original_asset_key") @db.VarChar(1024)
  optimizedAssetKey  String?    @map("optimized_asset_key") @db.VarChar(1024)
  thumbnailAssetKey  String?    @map("thumbnail_asset_key") @db.VarChar(1024)
  width              Int
  height             Int
  coordinateSystem   String     @default("layout-pixel-v1") @map("coordinate_system") @db.VarChar(64)
  version            Int        @default(1)
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")
  project            Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  units              Unit[]
  uploadIntent       LayoutUploadIntent?
  @@index([organizationId, projectId])
  @@map("layouts")
}

model LayoutUploadIntent {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  projectId      String       @map("project_id") @db.Uuid
  layoutId       String       @unique @map("layout_id") @db.Uuid
  assetKey       String       @unique @map("asset_key") @db.VarChar(1024)
  contentType    String       @map("content_type") @db.VarChar(64)
  expectedSize   Int          @map("expected_size")
  expiresAt      DateTime     @map("expires_at")
  finalizedAt    DateTime?    @map("finalized_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  layout         Layout       @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  @@index([organizationId, expiresAt])
  @@map("layout_upload_intents")
}

model Unit {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  projectId      String    @map("project_id") @db.Uuid
  layoutId       String    @map("layout_id") @db.Uuid
  unitNumber     String    @map("unit_number") @db.VarChar(40)
  unitType       UnitType  @map("unit_type")
  area           Decimal   @db.Decimal(14, 3)
  areaUnit       String    @default("SQFT") @map("area_unit") @db.VarChar(16)
  price          Decimal   @db.Decimal(18, 2)
  currency       String    @default("INR") @db.VarChar(3)
  status         UnitStatus @default(AVAILABLE)
  geometry       Json
  metadata       Json      @default("{}")
  publicMetadata Json      @default("{}") @map("public_metadata")
  version        Int       @default(1)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  layout         Layout    @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  bookings       Booking[]
  @@unique([projectId, unitNumber])
  @@index([organizationId, status, unitType])
  @@index([organizationId, projectId, price])
  @@map("units")
}

model Booking {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  projectId      String        @map("project_id") @db.Uuid
  unitId         String        @map("unit_id") @db.Uuid
  createdById    String        @map("created_by_id") @db.Uuid
  customerName   String        @map("customer_name") @db.VarChar(160)
  customerEmail  String?       @map("customer_email") @db.VarChar(320)
  customerPhone  String?       @map("customer_phone") @db.VarChar(32)
  status         BookingStatus @default(PENDING)
  expiresAt      DateTime?     @map("expires_at")
  notes          String?       @db.VarChar(2000)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  unit           Unit          @relation(fields: [unitId], references: [id], onDelete: Restrict)
  createdBy      User          @relation("BookingCreatedBy", fields: [createdById], references: [id])
  @@index([organizationId, status, createdAt])
  @@map("bookings")
}

model ApiKey {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String       @db.VarChar(100)
  keyPrefix      String       @map("key_prefix") @db.VarChar(16)
  keyHash        String       @unique @map("key_hash") @db.VarChar(128)
  scopes         String[]
  lastUsedAt     DateTime?    @map("last_used_at")
  expiresAt      DateTime?    @map("expires_at")
  revokedAt      DateTime?    @map("revoked_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId, revokedAt])
  @@map("api_keys")
}

model AuditLog {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  actorId        String?      @map("actor_id") @db.Uuid
  action         String       @db.VarChar(100)
  entityType     String       @map("entity_type") @db.VarChar(80)
  entityId       String       @map("entity_id") @db.VarChar(80)
  before         Json?
  after          Json?
  metadata       Json         @default("{}")
  ipAddress      String?      @map("ip_address") @db.VarChar(64)
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)
  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
  @@map("audit_logs")
}

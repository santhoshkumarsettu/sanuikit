{
  "name": "vstudio-platform",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "predev": "pnpm build",
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:generate": "pnpm --filter @vstudio/database generate",
    "db:migrate": "pnpm --filter @vstudio/database migrate",
    "db:seed": "pnpm --filter @vstudio/database seed",
    "db:studio": "pnpm --filter @vstudio/database studio",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.6.0",
    "turbo": "^2.5.0",
    "typescript": "~5.8.3",
    "eslint": "^9.33.0",
    "typescript-eslint": "^8.40.0"
  }
}
